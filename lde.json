{
	"name": "fs",
	"description": "A cross platform fs library for lde.",
	"authors": ["David Cruz <david@bycruz.dev>"],
	"version": "0.3.2",
	"dependencies": {
		"path": { "version": "^0.1.0" },
		"utf8": { "version": "^0.1.0" }
	},
	"features": {
		"windows": ["fs.raw.windows"],
		"linux": ["fs.raw.linux", "fs.raw.posix"],
		"macos": ["fs.raw.posix", "fs.raw.kqueue", "fs.raw.macos"],
		"bsd": ["fs.raw.posix", "fs.raw.kqueue", "fs.raw.bsd"],
		"unix": ["fs.raw.posix"]
	},
	"devDependencies": {
		"lde-test": { "git": "https://github.com/lde-org/lde" },
		"env": { "git": "https://github.com/lde-org/env" }
	}
}
